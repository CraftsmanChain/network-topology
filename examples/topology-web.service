[Unit]
Description=Topology Web
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/ops/web/topology/server
Environment=PORT=8181
Environment=WEB_ROOT=/ops/web/topology
Environment=CONFIG_DIR=/ops/web/topology/config
Environment=HOME=/root
Environment=GOCACHE=/root/.cache/go-build
ExecStart=/snap/bin/go run main.go
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
