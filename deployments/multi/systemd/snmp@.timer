[Unit]
Description=Check topology environment %i refresh eligibility

[Timer]
# This is a cheap eligibility check, not the collection interval.
# The collector enforces 10/15 minute cooldowns after actual completion.
OnBootSec=1min
OnUnitInactiveSec=1min
AccuracySec=5s
Unit=snmp@%i.service

[Install]
WantedBy=timers.target
